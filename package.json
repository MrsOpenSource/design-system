{
  "name": "@hsb_design/design-system",
  "version": "1.5.0",
  "description": "Multi-device enterprise design system framework for analytical dashboards and Gen AI applications",
  "type": "module",
  "bin": {
    "design-system": "./bin/cli.js"
  },
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./css": "./dist/css/design-system.css",
    "./tokens": {
      "import": "./dist/ts/tokens.ts",
      "types": "./dist/ts/tokens.ts"
    },
    "./cva": {
      "import": "./src/core/cva.ts",
      "types": "./src/core/cva.ts"
    },
    "./transforms": {
      "import": "./src/transforms/index.ts",
      "types": "./src/transforms/index.ts"
    }
  },
  "scripts": {
    "ui": "node bin/cli.js ui",
    "start": "node bin/cli.js ui",
    "build": "node scripts/build-tokens.mjs && node scripts/build-package.mjs",
    "build:package": "node scripts/build-package.mjs",
    "test": "node --test tests/**/*.test.mjs scripts/test-gap-scanner.mjs",
    "export": "node bin/cli.js export",
    "prepublishOnly": "node scripts/build-tokens.mjs && node scripts/build-package.mjs"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "scripts",
    "skills",
    "src",
    "tokens",
    "index.html",
    "showcase",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "tokens",
    "dashboard",
    "gen-ai",
    "figma",
    "lovable",
    "antigravity",
    "dtcg"
  ],
  "author": "Enterprise Design System Team",
  "license": "MIT"
}