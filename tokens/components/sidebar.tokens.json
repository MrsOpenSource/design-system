{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "component": {
    "sidebar": {
      "width": {
        "expanded": { "$value": "260px", "$type": "dimension" },
        "collapsed": { "$value": "68px", "$type": "dimension" }
      },
      "surface": { "$value": "{sys.color.surface.card}", "$type": "color" },
      "border": {
        "color": { "$value": "{sys.color.border.subtle}", "$type": "color" },
        "width": { "$value": "1px", "$type": "dimension" }
      },
      "item": {
        "height": { "$value": "40px", "$type": "dimension" },
        "radius": { "$value": "{radius.lg}", "$type": "dimension" },
        "active": {
          "background": { "$value": "rgba(37, 99, 235, 0.1)", "$type": "color" },
          "text": { "$value": "{sys.color.brand.primary}", "$type": "color" },
          "border": { "$value": "{sys.color.brand.primary}", "$type": "color" }
        },
        "inactive": {
          "background": { "$value": "transparent", "$type": "color" },
          "text": { "$value": "{sys.color.text.secondary}", "$type": "color" },
          "hover": {
            "background": { "$value": "{sys.color.surface.sunken}", "$type": "color" },
            "text": { "$value": "{sys.color.text.primary}", "$type": "color" }
          }
        }
      }
    }
  }
}

