{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "component": {
    "button": {
      "radius": {
        "sm": { "$value": "{radius.md}", "$type": "dimension" },
        "md": { "$value": "{radius.lg}", "$type": "dimension" },
        "lg": { "$value": "{radius.xl}", "$type": "dimension" },
        "pill": { "$value": "{radius.full}", "$type": "dimension" }
      },
      "spacing": {
        "sm": {
          "paddingX": { "$value": "{spacing.3}", "$type": "dimension" },
          "paddingY": { "$value": "{spacing.1-5}", "$type": "dimension" },
          "fontSize": { "$value": "{typography.font-size.xs}", "$type": "dimension" },
          "gap": { "$value": "{spacing.1-5}", "$type": "dimension" }
        },
        "md": {
          "paddingX": { "$value": "{spacing.4}", "$type": "dimension" },
          "paddingY": { "$value": "{spacing.2-5}", "$type": "dimension" },
          "fontSize": { "$value": "{typography.font-size.sm}", "$type": "dimension" },
          "gap": { "$value": "{spacing.2}", "$type": "dimension" }
        },
        "lg": {
          "paddingX": { "$value": "{spacing.6}", "$type": "dimension" },
          "paddingY": { "$value": "{spacing.3}", "$type": "dimension" },
          "fontSize": { "$value": "{typography.font-size.base}", "$type": "dimension" },
          "gap": { "$value": "{spacing.2-5}", "$type": "dimension" }
        }
      },
      "variant": {
        "primary": {
          "background": { "$value": "{sys.color.brand.primary}", "$type": "color" },
          "text": { "$value": "#ffffff", "$type": "color" },
          "border": { "$value": "transparent", "$type": "color" },
          "hover": {
            "background": { "$value": "{color.brand.placeholder-primary.700}", "$type": "color" }
          }
        },
        "secondary": {
          "background": { "$value": "{sys.color.surface.card}", "$type": "color" },
          "text": { "$value": "{sys.color.text.primary}", "$type": "color" },
          "border": { "$value": "{sys.color.border.default}", "$type": "color" },
          "hover": {
            "background": { "$value": "{sys.color.surface.sunken}", "$type": "color" }
          }
        },
        "outline": {
          "background": { "$value": "transparent", "$type": "color" },
          "text": { "$value": "{sys.color.brand.primary}", "$type": "color" },
          "border": { "$value": "{sys.color.brand.primary}", "$type": "color" },
          "hover": {
            "background": { "$value": "{color.brand.placeholder-primary.50}", "$type": "color" }
          }
        },
        "ghost": {
          "background": { "$value": "transparent", "$type": "color" },
          "text": { "$value": "{sys.color.text.secondary}", "$type": "color" },
          "border": { "$value": "transparent", "$type": "color" },
          "hover": {
            "background": { "$value": "{sys.color.surface.sunken}", "$type": "color" },
            "text": { "$value": "{sys.color.text.primary}", "$type": "color" }
          }
        },
        "danger": {
          "background": { "$value": "{sys.color.status.danger.surface}", "$type": "color" },
          "text": { "$value": "{sys.color.status.danger.text}", "$type": "color" },
          "border": { "$value": "{sys.color.status.danger.border}", "$type": "color" },
          "hover": {
            "background": { "$value": "{color.danger.600}", "$type": "color" },
            "text": { "$value": "#ffffff", "$type": "color" }
          }
        },
        "ai": {
          "background": { "$value": "linear-gradient(135deg, {sys.color.brand.primary}, {color.ai-special.accent-primary})", "$type": "string" },
          "text": { "$value": "#ffffff", "$type": "color" },
          "border": { "$value": "transparent", "$type": "color" },
          "shadow": { "$value": "{color.ai-special.glow}", "$type": "shadow" }
        }
      }
    }
  }
}

