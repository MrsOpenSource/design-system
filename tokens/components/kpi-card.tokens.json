{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "component": {
    "kpiCard": {
      "surface": { "$value": "{sys.color.surface.card}", "$type": "color" },
      "border": {
        "color": { "$value": "{sys.color.border.subtle}", "$type": "color" },
        "width": { "$value": "1px", "$type": "dimension" },
        "radius": { "$value": "{radius.xl}", "$type": "dimension" }
      },
      "shadow": {
        "default": { "$value": "{shadow.sm}", "$type": "shadow" },
        "hover": { "$value": "{shadow.md}", "$type": "shadow" }
      },
      "padding": {
        "comfortable": { "$value": "{spacing.6}", "$type": "dimension" },
        "compact": { "$value": "{spacing.4}", "$type": "dimension" }
      },
      "eyebrow": {
        "color": { "$value": "{sys.color.text.secondary}", "$type": "color" },
        "fontSize": { "$value": "{typography.font-size.xs}", "$type": "dimension" },
        "fontWeight": { "$value": "{typography.font-weight.medium}", "$type": "fontWeight" },
        "textTransform": { "$value": "uppercase", "$type": "string" },
        "letterSpacing": { "$value": "{typography.letter-spacing.wide}", "$type": "dimension" }
      },
      "metric": {
        "color": { "$value": "{sys.color.text.primary}", "$type": "color" },
        "fontSize": { "$value": "{typography.font-size.3xl}", "$type": "dimension" },
        "fontWeight": { "$value": "{typography.font-weight.bold}", "$type": "fontWeight" },
        "fontVariantNumeric": { "$value": "tabular-nums", "$type": "string" }
      },
      "delta": {
        "positive": {
          "background": { "$value": "{sys.color.status.success.surface}", "$type": "color" },
          "text": { "$value": "{sys.color.status.success.text}", "$type": "color" },
          "border": { "$value": "{sys.color.status.success.border}", "$type": "color" }
        },
        "negative": {
          "background": { "$value": "{sys.color.status.danger.surface}", "$type": "color" },
          "text": { "$value": "{sys.color.status.danger.text}", "$type": "color" },
          "border": { "$value": "{sys.color.status.danger.border}", "$type": "color" }
        },
        "neutral": {
          "background": { "$value": "{color.neutral.100}", "$type": "color" },
          "text": { "$value": "{sys.color.text.secondary}", "$type": "color" },
          "border": { "$value": "{color.neutral.200}", "$type": "color" }
        },
        "radius": { "$value": "{radius.full}", "$type": "dimension" },
        "paddingX": { "$value": "{spacing.2}", "$type": "dimension" },
        "paddingY": { "$value": "{spacing.1}", "$type": "dimension" }
      },
      "sparkline": {
        "height": {
          "laptop": { "$value": "56px", "$type": "dimension" },
          "tablet": { "$value": "48px", "$type": "dimension" },
          "mobile": { "$value": "40px", "$type": "dimension" }
        },
        "strokeWidth": { "$value": "2px", "$type": "dimension" },
        "fillOpacity": { "$value": 0.15, "$type": "number" }
      }
    }
  }
}

